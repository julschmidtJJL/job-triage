ANTHROPIC_API_KEY=your_key_here
# The board: notion, or csv for board/jobs.csv (no account; the NOTION_ lines are then not needed)
BOARD=notion
NOTION_API_KEY=your_notion_integration_token
NOTION_JOB_BOARD_DB_ID=your_database_id_here
NOTION_DATA_SOURCE_ID=your_data_source_id_here
SERPAPI_KEY=your_scaleserp_key_here
# Optional overrides
# SCORING_MODEL=claude-haiku-5-5
# CLAUDE_SCORE_THRESHOLD=20
# JOB_HUNT_TOP_N=30
# MIN_NOTION_SCORE=40
# JOB_RADIUS_KM=50
# LETTER_MODEL=claude-sonnet-5-5
# FIT_PROFILE is read from profile/profile.md locally; set it only to override.
# LETTER_FACTS is read from profile/letter_facts.md locally; set it only to override.
