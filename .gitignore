# Secrets
.env

# Private: the fit profile is distilled from personal notes and mail
profile/profile.md
# Private too: the only facts a cover letter may state
profile/letter_facts.md

# BOARD=csv: your job board. Ignored so it never reaches a public copy by
# accident; on Actions the workflow adds it to your private repository.
board/

# Runtime state and output (cached across Actions runs, never committed)
data/
logs/

# Python / tooling
__pycache__/
*.py[co]
.venv/
venv/
.pytest_cache/
.idea/
.gstack/
.DS_Store
